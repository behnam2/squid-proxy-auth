PROXY_USERNAME=myuser
PROXY_PASSWORD=change-me-to-a-strong-password

# Optional: comma-separated source IPs/CIDRs that bypass auth
# ALLOWED_IPS=203.0.113.10,198.51.100.20

# Optional: comma-separated domains fetched directly, bypassing the parent peer
# DIRECT_DOMAINS=service.internal.example.com,.example.com

# Optional: upstream parent proxy (host port [options])
# CACHE_PEER=192.0.2.100 53128
# CACHE_PEER_NEVER_DIRECT=1

# Optional: custom names
# CONTAINER_NAME=squidproxy
# CACHE_VOLUME_NAME=squid-cache
# COMPOSE_PROJECT_NAME=squid-proxy-auth
# PROXY_PORT=3128
